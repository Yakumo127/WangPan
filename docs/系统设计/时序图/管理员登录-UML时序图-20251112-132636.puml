@startuml
title 管理员登录功能时序图（可选）

actor 管理员 as Admin
participant "浏览器/登录页\n(自定义入口)" as UI
participant "Axios\nrequest.js" as Axios
participant "认证控制器\nAuthController" as AuthCtrl
participant "用户服务\nUserService" as UserSvc
participant "Spring Security\nAuthenticationManager" as AuthMgr
participant "验证码服务\nCaptchaService" as CaptchaSvc
participant "JWT 工具\nJwtUtils" as Jwt
database "UserRepository\n(MySQL)" as DB

Admin -> UI: 输入用户名/密码/(验证码)
UI -> Axios: POST /api/auth/admin-login\n{ username,password,captcha?,captchaKey? }
Axios -> AuthCtrl: adminLogin(dto)
AuthCtrl -> UserSvc: adminLogin(dto)
UserSvc -> DB: findByUsername(username)
alt 非 ADMIN/禁用/锁定
  UserSvc --> AuthCtrl: 抛出 “权限不足/用户已被禁用/已锁定”
  AuthCtrl --> Axios: 400 { message }
  Axios --> UI: 显示错误
  return
end
opt 失败≥3次强制验证码；否则提供则校验
  UserSvc -> CaptchaSvc: validateCaptcha(key, code)
  alt 错误/过期
    UserSvc --> AuthCtrl: 抛出 “验证码错误或已过期/请先输入验证码”
    AuthCtrl --> Axios: 400 { message }
    return
  end
end
alt 密码正确
  UserSvc -> AuthMgr: authenticate(username,password)
  AuthMgr --> UserSvc: Authentication
  UserSvc -> DB: 重置 loginAttempts=0, 更新 lastLoginTime
  UserSvc -> Jwt: generateToken(userDetails)
  Jwt --> UserSvc: token
  UserSvc --> AuthCtrl: token
  AuthCtrl --> Axios: 200 { token }
else 密码错误
  UserSvc -> DB: loginAttempts+1; ≥5 锁定
  UserSvc --> AuthCtrl: 抛出 “用户名或密码错误/账户已被锁定”
  AuthCtrl --> Axios: 400 { message }
end

@enduml

