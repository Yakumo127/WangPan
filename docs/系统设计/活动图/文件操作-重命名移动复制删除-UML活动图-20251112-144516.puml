@startuml
title 企业文件管理系统 - 文件操作（重命名/移动/复制/删除）UML 活动图

start
partition 重命名 {
  :用户输入新名称;
  :前端提交\nPUT /api/files/{fileId}/rename\n{ name };
  :后端解析 userId;
  :校验归属与未删除, 更新 originalFilename 并保存;
  :返回 200 { fileId, filename };
}

partition 移动 {
  :用户选择目标文件夹;
  :前端提交\nPOST /api/files/{fileId}/move\n{ folderId };
  :后端解析 userId;
  :查找文件与目标文件夹并更新归属, 保存;
  :返回 200 { fileId, folderId };
}

partition 复制 {
  :用户选择目标文件夹;
  :前端提交\nPOST /api/files/{fileId}/copy\n{ folderId };
  :后端解析 userId;
  :复制记录并保存;
  :返回 200 { fileId, filename };
}

partition 删除(移入回收站) {
  :前端提交\nDELETE /api/files/{fileId};
  :后端解析 userId;
  :标记 deleted=true, deleteTime=now 并保存;
  :返回 200 { quotaUsed, quotaLimit };
}

stop

@enduml

