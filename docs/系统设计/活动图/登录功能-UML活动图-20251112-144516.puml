@startuml
title 企业文件管理系统 - 登录功能 UML 活动图

start
:前端校验必填与格式;
:前端提交\nPOST /api/auth/login\n{ username, password, captcha?, captchaKey? };
:后端查询用户\n(DB: findByUsername);
if (用户存在?) then (是)
  if (用户禁用或锁定?) then (是)
    :返回 400 { message: 用户已被禁用/锁定 };
    stop
  else (否)
    if (失败次数>=3 需验证码?) then (是)
      if (验证码缺失或错误?) then (是)
        :返回 400 { message: 验证码错误或已过期/请先输入验证码 };
        stop
      else (否)
        :通过验证码校验;
      endif
    else (否)
      if (用户提供了验证码?) then (是)
        if (验证码错误?) then (是)
          :返回 400 { message: 验证码错误或已过期 };
          stop
        else (否)
          :通过验证码校验;
        endif
      endif
    endif
    :认证用户名/密码 (AuthenticationManager);
    if (密码正确?) then (是)
      :重置 loginAttempts=0, 更新 lastLoginTime;
      :生成 JWT (JwtUtils.generateToken);
      :返回 200 { token };
      :前端保存 token 至 localStorage;
      :前端请求用户信息\nGET /api/auth/userinfo\nAuthorization: Bearer <token>;
      :更新前端用户与角色状态;
      stop
    else (否)
      :累加 loginAttempts;
      if (loginAttempts >= 5?) then (是)
        :锁定账户 locked=true;
        :返回 400 { message: 账户已被锁定 };
      else (否)
        :返回 400 { message: 用户名或密码错误 };
      endif
      stop
    endif
  endif
else (否)
  :返回 400 { message: 用户名或密码错误 };
  stop
endif

@enduml

